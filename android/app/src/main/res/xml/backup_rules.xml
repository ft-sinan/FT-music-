<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <!-- MediaStore IDs/paths are device-specific; restoring them could target a different file. -->
    <exclude domain="sharedpref" path="ft_shared_downloads.xml" />
    <exclude domain="sharedpref" path="ft_shared_pending_removals.xml" />
    <exclude domain="sharedpref" path="ft_download_sources.xml" />
    <exclude domain="sharedpref" path="ft_streaming_cache_ages.xml" />
</full-backup-content>